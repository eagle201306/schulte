<view class="container result-page" wx:if="{{result}}">
  <view class="result-head">
    <view class="result-kicker">TRAINING COMPLETE</view>
    <view class="result-title">训练完成</view>
    <view class="result-mode">{{result.size}} × {{result.size}} · 数字舒尔特表</view>
  </view>

  <view class="score-card card">
    <view class="score-top">
      <view>
        <view class="score-label">专注力评分</view>
        <view class="score-caption">{{scoreLabel}}</view>
      </view>
      <view class="score-number">{{result.score}}</view>
    </view>
    <view class="score-track">
      <view class="score-fill" style="width: {{result.score}}%;"></view>
    </view>
    <view class="best-note" wx:if="{{isBest}}">本次刷新当前难度最佳成绩</view>
  </view>

  <view class="main-stat card">
    <view class="main-value">{{durationText}}</view>
    <view class="main-label">完成时间</view>
    <view class="best-line">当前难度最佳：{{bestText}}</view>
  </view>

  <view class="stats-grid">
    <view class="stat-card card">
      <view class="stat-value">{{result.accuracy}}%</view>
      <view class="stat-label">准确率</view>
    </view>
    <view class="stat-card card">
      <view class="stat-value">{{result.errors}}</view>
      <view class="stat-label">错误次数</view>
    </view>
    <view class="stat-card card">
      <view class="stat-value small">{{avgReactionText}}</view>
      <view class="stat-label">平均反应</view>
    </view>
    <view class="stat-card card">
      <view class="stat-value small">{{fastestText}}</view>
      <view class="stat-label">最快反应</view>
    </view>
  </view>

  <view class="detail card">
    <view class="detail-row">
      <text>最快反应</text>
      <text>{{fastestText}}</text>
    </view>
    <view class="detail-row">
      <text>最慢反应</text>
      <text>{{slowestText}}</text>
    </view>
    <view class="detail-row last">
      <text>总点击数</text>
      <text>{{result.total + result.errors}}</text>
    </view>
  </view>

  <button class="primary-btn" bindtap="trainAgain">再练一次</button>
  <view class="bottom-actions">
    <view bindtap="openHistory">历史成绩</view>
    <view class="dot">·</view>
    <view bindtap="goHome">返回首页</view>
  </view>
</view>
