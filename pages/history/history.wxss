.history-page {
  padding-top: 36rpx;
}

.page-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 0 6rpx 26rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 820;
}

.subtitle {
  margin-top: 9rpx;
  color: #8c919d;
  font-size: 24rpx;
}

.clear {
  margin-top: 10rpx;
  padding: 10rpx 6rpx;
  color: #9a9faa;
  font-size: 23rpx;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 20rpx;
}

.filter {
  flex: none;
  min-width: 86rpx;
  padding: 14rpx 20rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #777d88;
  font-size: 22rpx;
}

.filter.active {
  background: #17191f;
  color: #ffffff;
}

.overview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.overview-item {
  padding: 25rpx 10rpx 22rpx;
  text-align: center;
}

.overview-value {
  font-size: 30rpx;
  font-weight: 780;
}

.overview-label {
  margin-top: 7rpx;
  color: #979ca7;
  font-size: 19rpx;
}

.record-list {
  margin-top: 20rpx;
}

.record {
  display: grid;
  grid-template-columns: 130rpx 1fr 78rpx;
  gap: 16rpx;
  align-items: center;
  padding: 25rpx 24rpx;
  margin-bottom: 14rpx;
}

.record-size {
  font-size: 27rpx;
  font-weight: 760;
}

.record-date,
.record-sub {
  margin-top: 6rpx;
  color: #999eaa;
  font-size: 20rpx;
}

.record-main {
  text-align: right;
}

.record-time {
  font-size: 31rpx;
  font-weight: 800;
}

.score-badge {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f1f4;
  font-size: 25rpx;
  font-weight: 780;
}

.empty {
  margin-top: 20rpx;
  padding: 58rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 29rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 12rpx;
  color: #969ba7;
  font-size: 23rpx;
  line-height: 1.7;
}
